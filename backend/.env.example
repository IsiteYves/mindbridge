DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge@localhost:5432/mindbridge
SECRET_KEY=change-me-to-a-long-random-string
TEST_DATABASE_URL=postgresql+psycopg://mindbridge:mindbridge@localhost:5432/mindbridge_test
CANVAS_BASE_URL=https://alueducation.instructure.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Email for verification codes and password resets (required to sign up).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=MindBridge <you@example.com>
# Encrypts the stored Canvas API token. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# Plan-review agent (app/services/agent/). Optional: the deterministic, rule-based
# part of plan review works with neither of these set. Setting both adds one more
# AI-assisted observation on top. Leave ANTHROPIC_API_KEY unset to run with no spend.
ANTHROPIC_API_KEY=
# Pick a currently available Claude model id from Anthropic's docs; not guessed here.
AGENT_MODEL=
